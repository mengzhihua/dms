# DMS 一键部署环境变量（复制为 .env 后按需修改）

# 前端对外端口
DMS_HTTP_PORT=80

# MySQL root 密码（首次初始化时生效，勿留空）
DMS_DB_PASSWORD=root

# JWT 签名密钥（必填，建议随机长字符串）
DMS_JWT_SECRET=

# 首次启动创建 admin 账号的密码（留空则随机生成并打印在 backend 日志中）
DMS_ADMIN_PASSWORD=

# Spring profiles（默认 prod,mysql 生产模式无演示数据；本地验收可用 mysql 加载演示数据）
DMS_PROFILES=prod,mysql
